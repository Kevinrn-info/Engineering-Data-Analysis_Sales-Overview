# Copy this file to .env and adjust the values. Never commit .env.
# These are local development credentials only.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=summitbase
POSTGRES_USER=summitbase
POSTGRES_PASSWORD=change_me

# pgAdmin (optional, started with: docker compose --profile tools up -d)
PGADMIN_DEFAULT_EMAIL=admin@summitbase.local
PGADMIN_DEFAULT_PASSWORD=change_me
