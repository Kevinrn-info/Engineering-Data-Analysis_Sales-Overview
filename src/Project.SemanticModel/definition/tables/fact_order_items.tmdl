table fact_order_items
	lineageTag: 1e02c223-1a01-5973-9139-7701032dfeba

	measure 'Net Sales' = CALCULATE ( SUM ( fact_order_items[net_sales] ), fact_order_items[is_completed_sale] = TRUE () )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Profitability
		lineageTag: f6d62e6b-7840-5677-ac2d-47d55a757252

	measure 'Total COGS' = CALCULATE ( SUM ( fact_order_items[cogs] ), fact_order_items[is_completed_sale] = TRUE () )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Profitability
		lineageTag: 2e586117-5743-59ac-9fc2-0275f317ccc9

	measure 'Gross Profit' = [Net Sales] - [Total COGS]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Profitability
		lineageTag: c0f5418f-0617-5f9c-a508-f6c75b003d73

	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Net Sales] )
		formatString: 0.0%
		displayFolder: Profitability
		lineageTag: eb772507-38aa-52e5-91a6-6063a450ceaa

	measure 'Units Sold' = CALCULATE ( SUM ( fact_order_items[quantity] ), fact_order_items[is_completed_sale] = TRUE () )
		formatString: #,0
		displayFolder: Profitability
		lineageTag: 7e01d17b-11b2-50c5-9a21-303b82fd8bfc

	measure 'Order Lines' = COUNTROWS ( fact_order_items )
		formatString: #,0
		displayFolder: Profitability
		lineageTag: e5b55bc8-9242-5ddb-b92c-9bee34d82684

