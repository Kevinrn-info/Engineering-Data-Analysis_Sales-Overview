table fact_returns
	lineageTag: 78f0ef40-2f2c-5278-bdb0-91c80aa916f8

	measure 'Returned Lines' = COUNTROWS ( fact_returns )
		formatString: #,0
		displayFolder: Returns
		lineageTag: 73e4a365-3cc6-54c4-bcf2-e4ca9dd35f90

	measure 'Refund Amount' = SUM ( fact_returns[refund_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Returns
		lineageTag: 8c9bc394-f423-53b8-a840-3ba7d4019c4a

	measure 'Avg Days to Return' = AVERAGE ( fact_returns[days_to_return] )
		formatString: 0.0
		displayFolder: Returns
		lineageTag: af89d2a6-aba7-5254-8edc-abb0a2baef4c

	measure 'Item Return Rate' =
			VAR _returned =
			    CALCULATE (
			        COUNTROWS ( fact_returns ),
			        USERELATIONSHIP ( fact_returns[order_date], dim_date[date] )
			    )
			RETURN
			    DIVIDE ( _returned, [Order Lines] )
		formatString: 0.0%
		displayFolder: Returns
		lineageTag: fbd9804d-ddca-5d3a-98ca-83f7feccf1c2

