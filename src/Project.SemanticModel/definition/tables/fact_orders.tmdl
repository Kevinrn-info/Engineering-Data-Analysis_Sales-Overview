table fact_orders
	lineageTag: 910d1ecd-7582-5281-a3d1-e3ae6afbc88e

	measure Orders = COUNTROWS ( fact_orders )
		formatString: #,0
		displayFolder: Orders
		lineageTag: 97404d36-d433-5fd1-aefc-eacfe2ba9dbc

	measure 'Completed Orders' = CALCULATE ( [Orders], fact_orders[is_completed_sale] = TRUE () )
		formatString: #,0
		displayFolder: Orders
		lineageTag: e6cda085-f5ee-5d60-9435-84fa28dd3bf5

	measure 'Cancelled Orders' = CALCULATE ( [Orders], fact_orders[is_cancelled] = TRUE () )
		formatString: #,0
		displayFolder: Orders
		lineageTag: ca7c5b83-821d-5755-bbd9-5d0d3c0bd949

	measure 'Returned Orders' = CALCULATE ( [Orders], fact_orders[is_returned] = TRUE () )
		formatString: #,0
		displayFolder: Orders
		lineageTag: 750e21ee-5ba9-5830-aad6-250ef47ea019

	measure 'Cancellation Rate' = DIVIDE ( [Cancelled Orders], [Orders] )
		formatString: 0.0%
		displayFolder: Orders
		lineageTag: 6298657f-c0ba-5c12-a9e8-5a769cbf2d10

	measure 'Order Return Rate' = DIVIDE ( [Returned Orders], [Orders] )
		formatString: 0.0%
		displayFolder: Orders
		lineageTag: 88b78896-78e2-5c6e-af4f-70d39482916f

	measure 'Net Revenue' = CALCULATE ( SUM ( fact_orders[total_amount] ), fact_orders[is_completed_sale] = TRUE () )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Revenue
		lineageTag: e12bdbd6-e7da-5cc3-ae44-139dcbf8159e

	measure 'Gross Order Value' = SUM ( fact_orders[total_amount] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Revenue
		lineageTag: ef101e59-cc98-5fdd-a37a-13b22a39628c

	measure 'Average Order Value' = DIVIDE ( [Net Revenue], [Completed Orders] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Revenue
		lineageTag: 6f9f82aa-45c7-55be-981d-0cbbb751405e

	measure 'Discount Rate' = DIVIDE ( SUM ( fact_orders[discount_amount] ), SUM ( fact_orders[subtotal] ) )
		formatString: 0.0%
		displayFolder: Revenue
		lineageTag: 48dd357d-f699-5659-94b4-9a81726d62b3

	measure 'Net Revenue PY' = CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time Intelligence
		lineageTag: a3a75dd7-027d-5468-9533-24be7c884aa9

	measure 'Net Revenue YoY %' = DIVIDE ( [Net Revenue] - [Net Revenue PY], [Net Revenue PY] )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 4b2f9bfd-1253-502d-af86-ac397eced9dd

	measure 'Net Revenue YTD' = TOTALYTD ( [Net Revenue], dim_date[date] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time Intelligence
		lineageTag: 9925a7a9-4e6d-56d1-b763-a34a2a0d5980

	measure 'Active Customers' = CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_id] ), fact_orders[is_completed_sale] = TRUE () )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 0805be37-de13-5fed-814c-4209b1eb5fe0

	measure 'Revenue per Customer' = DIVIDE ( [Net Revenue], [Active Customers] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Customers
		lineageTag: 563b415d-8b66-55a7-b31b-21bfa30a9d02

	measure 'New Customers' =
			VAR _start = MIN ( dim_date[date] )
			VAR _end = MAX ( dim_date[date] )
			RETURN
			    CALCULATE (
			        COUNTROWS ( dim_customer ),
			        dim_customer[first_order_date] >= _start,
			        dim_customer[first_order_date] <= _end
			    )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 6d40adef-c786-54ed-902c-0dafaa255379

	measure 'Avg Days to Deliver' = AVERAGE ( fact_orders[days_to_deliver] )
		formatString: 0.0
		displayFolder: Logistics
		lineageTag: 39fecc50-0d1b-5d3f-96c8-b6c147863dd2

	measure 'Avg Days in Transit' = AVERAGE ( fact_orders[days_in_transit] )
		formatString: 0.0
		displayFolder: Logistics
		lineageTag: 02f5c063-c66c-59b6-ad7d-7676da80c14c

